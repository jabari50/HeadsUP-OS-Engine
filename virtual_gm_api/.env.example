# ── The Virtual GM · Environment Variables ────────────────────────────────────
# Copy to .env and fill in your values.  NEVER commit .env to version control.

# ── Required: API auth ────────────────────────────────────────────────────────
# Bearer token operators send in every request (any strong random string)
VIRTUAL_GM_API_KEY=change-me-strong-random-string

# Bearer token for Jabari-only admin endpoints (/admin/*)
VIRTUAL_GM_ADMIN_KEY=change-me-jabari-admin-key

# ── Required: PRO-File OS ─────────────────────────────────────────────────────
PRO_FILE_OS_API_URL=https://api.profilios.com/v1
PRO_FILE_OS_API_KEY=your-pro-file-os-api-key

# ── Optional: storage & logging ───────────────────────────────────────────────
VGM_DB_PATH=virtual_gm.db
VGM_LOG_PATH=virtual_gm.log

# ── Optional: CORS (comma-separated origins) ──────────────────────────────────
VGM_ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com
