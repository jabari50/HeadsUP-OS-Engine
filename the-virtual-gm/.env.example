# Supabase (HeadsUP OS project)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose client-side. Currently unused by the app
# (all writes go through RLS-scoped server actions) — reserved for admin jobs.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Anthropic (reserved for matchmaking intelligence)
ANTHROPIC_API_KEY=

# Cloudflare Turnstile (captcha on /join). Optional — when unset, /join falls
# back to rate-limit + honeypot only. Get keys at dash.cloudflare.com → Turnstile.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
